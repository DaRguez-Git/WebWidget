<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        AppCompat DayNight is enough here because the configuration screen is
        rendered with Compose Material3, which doesn't read its theme from XML.
        The XML theme only controls system bars + window background until the
        Compose tree takes over.

        Avoiding Theme.Material3.* on purpose: that style lives in
        com.google.android.material, which we don't depend on (Compose's
        material3 artifact does NOT provide XML themes).
    -->
    <style name="Theme.WebWidget" parent="Theme.AppCompat.DayNight.NoActionBar" />
</resources>
