<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget metadata.

    Sizing:
      - minWidth/minHeight set the absolute floor (~2x2 cell on most launchers
        at ~55 dp/cell).
      - targetCellWidth/Height are advisory for API 31+ launchers, defaulting
        to 4x2 (the most common shape for a wide page snapshot).
      - minResize* allows shrinking to 2x2.
      - maxResize* allows growing to ~5x5 (480dp on a typical phone is around
        a 5-cell square). Combined with resizeMode="horizontal|vertical" the
        user can drag to any cell-size between 2x2 and 5x5.

    updatePeriodMillis is intentionally 0: WorkManager owns the cadence.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="480dp"
    android:maxResizeHeight="480dp"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_web"
    android:previewImage="@drawable/ic_widget_preview"
    android:previewLayout="@layout/widget_web"
    android:configure="com.lonewren.webwidget.config.WidgetConfigurationActivity"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description" />
