<?xml version="1.0" encoding="utf-8"?>
<!--
    RemoteViews layout for the home-screen widget.

    Constraint: RemoteViews supports a tiny set of scrollable containers:
    ListView, GridView, StackView, AdapterViewFlipper. ScrollView is NOT
    supported. To get vertical scrolling we use a ListView whose rows are
    image tiles sliced from a tall full-page snapshot. The listview is
    populated by WebWidgetRemoteViewsService through setRemoteAdapter.

    The TextView serves as the empty view (setEmptyView). It is shown
    automatically by the launcher whenever the ListView reports zero rows
    — i.e. before the first snapshot lands.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <ListView
        android:id="@+id/widget_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="vertical"
        android:overScrollMode="never"
        android:listSelector="@android:color/transparent" />

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="12dp"
        android:textColor="@color/widget_error_text"
        android:textSize="14sp"
        android:text="@string/widget_loading" />

</FrameLayout>
